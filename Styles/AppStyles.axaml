<!--
    Fichier      :  AppStyles.axaml
    Projet       :  AlpenMux

    Description  :  Styles réutilisables : cartes, titres, icônes, états (ok / warn / error),
                    boutons, console, barre de navigation.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="FontFamily" Value="{StaticResource Helvetica}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
    </Style>

    <!-- Cartes -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.stat">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Moniteur modulable : cadre d'arrivée pendant un glisser-déposer, petits boutons d'une carte -->
    <Style Selector="Border.tileGhost">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Button.tileBtn">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Titres et textes -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}" />
    </Style>
    <Style Selector="TextBlock.small, SelectableTextBlock.small">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Tout champ d'une seule ligne : texte et indication centrés verticalement (les zones multilignes restent en haut) -->
    <Style Selector="TextBox[AcceptsReturn=False]">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Aide sous un champ -->
    <Style Selector="TextBlock.help">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Icônes -->
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{StaticResource Phosphor}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.icon.big">
        <Setter Property="FontSize" Value="26" />
    </Style>
    <Style Selector="TextBlock.icon.fill">
        <Setter Property="FontFamily" Value="{StaticResource PhosphorFill}" />
    </Style>

    <!-- États -->
    <Style Selector="TextBlock.ok">
        <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.warn">
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="TextBlock.error, SelectableTextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Boutons : contenu icône + texte -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Button > StackPanel.btn">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Button > StackPanel.btn > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Barres de progression -->
    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ProgressBar.thin">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="5" />
        <Setter Property="Height" Value="5" />
    </Style>
    <Style Selector="ProgressBar.warn">
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="ProgressBar.error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!-- Console -->
    <Style Selector="Border.console">
        <Setter Property="Background" Value="{DynamicResource ConsoleBackground}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <!-- Journal en liste (console d'un serveur, benchmark) : lignes serrées -->
    <Style Selector="ListBox.console ListBoxItem">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border.console SelectableTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ConsoleForeground}" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Barre de navigation -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Listes "cartes" (modèles, serveurs) -->
    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Padding" Value="0,8,0,0" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
</Styles>
