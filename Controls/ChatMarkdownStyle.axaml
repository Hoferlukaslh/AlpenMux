<!--
    Fichier      :  ChatMarkdownStyle.axaml
    Projet       :  AlpenMux
    Description  :  Rendu Markdown des messages du chat (Markdown.Avalonia), aux couleurs de l'application
                    (thèmes clair et sombre) : texte courant, titres sobres, listes peu décalées, code en bloc
                    arrondi couleur console, tableaux à bordures fines, citations avec barre d'accent.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mdc="clr-namespace:Markdown.Avalonia.Controls;assembly=Markdown.Avalonia"
        xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        x:Class="AlpenMux.Controls.ChatMarkdownStyle">

    <!-- Texte courant -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Titres -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading2">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading3">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading4">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,2" />
    </Style>

    <!-- Liens -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CHyperlink">
        <Setter Property="IsUnderline" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Listes : décalage léger, puces de la couleur d'accent -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.List">
        <Setter Property="Margin" Value="14,0,0,0" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.ListMarker">
        <Setter Property="Margin" Value="0,3,8,3" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Code dans le texte -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CCode">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBorder}" />
    </Style>

    <!-- Bloc de code -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.CodeBlock">
        <Setter Property="Background" Value="{DynamicResource ConsoleBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock.CodeBlock, .Markdown_Avalonia_MarkdownViewer SelectableTextBlock.CodeBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource ConsoleForeground}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer SelectableTextBlock.CodeBlock">
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}" />
    </Style>
    <!-- En-tête du bloc de code : langue à gauche, bouton « Copier » à droite -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.CodeHeader">
        <Setter Property="Margin" Value="0,-4,-6,6" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock.CodeLang">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource ConsoleForeground}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Button.CodeCopy TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ConsoleForeground}" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Button.CodeCopy TextBlock.icon">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Button.CodeCopy">
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Button.CodeCopy:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Tableaux : bordures fines, en-tête teinté -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Table">
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.Table > Border">
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Grid.Table">
        <Setter Property="mdc:AutoScaleColumnDefinitions.IsEnabled" Value="True" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TableHeader">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TableHeader ctxt|CTextBlock">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.EvenTableRow">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
    </Style>

    <!-- Citations -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Blockquote">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer StackPanel.Blockquote">
        <Setter Property="Margin" Value="12,2" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer StackPanel.Blockquote ctxt|CTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}" />
    </Style>

    <!-- Images (diagrammes Mermaid) : taille naturelle, réduites si elles dépassent la largeur de la bulle -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CImage">
        <Setter Property="FittingWhenProtrude" Value="True" />
        <Setter Property="SaveAspectRatio" Value="True" />
    </Style>

    <!-- Note, ligne horizontale -->
    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Note">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector=".Markdown_Avalonia_MarkdownViewer mdc|Rule">
        <Setter Property="Margin" Value="0,8" />
    </Style>
</Styles>
